# ---------------------------------------------------------------------------
# LeadScout environment configuration
# Copy this file to `.env` and adjust the values for your machine.
# Every value below is validated at startup (src/config/env.ts).
# ---------------------------------------------------------------------------

# Runtime environment: development | production | test
NODE_ENV=development

# --- Database ---------------------------------------------------------------
# Supabase / PostgreSQL connection string (direct or pooled).
# Special characters in the password must be URL-encoded (for example "@" becomes "%40").
# Example Supabase direct connection:
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"
# Example Supabase connection pooler:
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"
# Connection pool sizing (mysql2/promise).
DATABASE_CONNECTION_LIMIT=10
# Queued acquisition requests; 0 means unlimited.
DATABASE_QUEUE_LIMIT=0
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=60000
# Retries for transient failures (lost connection, deadlock).
DATABASE_RETRY_ATTEMPTS=2
DATABASE_RETRY_DELAY_MS=500
# Statements slower than this are logged at warn level.
DATABASE_SLOW_QUERY_MS=500
# Log every SQL statement at debug level (development only).
DATABASE_LOG_QUERIES=false

# Optional: separate database for integration tests. Defaults to
# <database>_test derived from DATABASE_URL. Its name must end with "_test".
# DATABASE_URL_TEST="mysql://root:password@localhost:3306/leadscout_test"

# --- Logging ----------------------------------------------------------------
# error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_DIR=logs

# --- Filesystem -------------------------------------------------------------
# Relative paths are resolved against the project root.
OUTPUT_DIR=output
SCREENSHOT_DIR=screenshots

# --- Scraping engine --------------------------------------------------------
# Parallel browser workers (1-32).
SCRAPER_WORKERS=4
SCRAPER_HEADLESS=true
# chromium | firefox | webkit
SCRAPER_BROWSER_TYPE=chromium
SCRAPER_RETRY_COUNT=3
SCRAPER_TIMEOUT_MS=30000
SCRAPER_NAVIGATION_TIMEOUT_MS=45000
# Requests per minute per worker.
SCRAPER_RATE_LIMIT_PER_MINUTE=60
SCRAPER_SCROLL_DELAY_MS=1200
SCRAPER_MAX_SCROLLS=250
SCREENSHOTS_ENABLED=true

# --- Proxy rotation ---------------------------------------------------------
PROXY_ENABLED=false
# Comma separated list, e.g. http://ip1:port,http://ip2:port
PROXY_URLS=
PROXY_USERNAME=
PROXY_PASSWORD=

# --- Website verification ---------------------------------------------------
VERIFICATION_CONCURRENCY=5
VERIFICATION_TIMEOUT_MS=15000
VERIFICATION_MAX_SEARCH_RESULTS=10
VERIFICATION_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36"
